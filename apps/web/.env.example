# Directus CMS
# Server-side only - used for data fetching and /api/config
DIRECTUS_URL=http://localhost:8055
DIRECTUS_TOKEN=your-static-token-here

# Umami Analytics
# Server-side - served to client via /api/config endpoint
ANALYTICS_ENABLED=true
UMAMI_WEBSITE_ID=your-website-id
UMAMI_SCRIPT_URL=http://localhost:3001/script.js

# GlitchTip Error Tracking (Sentry-compatible)
# Get DSN from: GlitchTip Dashboard -> Project -> Settings -> Client Keys (DSN)
# Format: https://<key>@<host>/<project-id>
SENTRY_DSN=https://your-key@monitoring.sbozh.me/1

# SMTP (mailbox.org) — sends the /contact letters (lib/mail.ts).
# UNSET IS A WORKING DEV MODE: nothing is sent, both letters are printed to
# the dev-server console instead. Port 587 (STARTTLS): Hetzner blocks 465.
# Keep real credentials out of here — this file goes into image builds.
#SMTP_HOST=smtp.mailbox.org
#SMTP_PORT=587
#SMTP_USER=noreply@sbozh.me
#SMTP_PASSWORD=
#MAIL_FROM=sbozh.me <noreply@sbozh.me>
#CONTACT_INBOX=sem.bozhyk@sbozh.me
#CONTACT_FROM=

# News subscriptions (sent over the SMTP_* account above)
# SUBSCRIBE_SECRET signs confirm/unsubscribe links: openssl rand -hex 32
# Rotating it breaks every unsubscribe link already sent
SUBSCRIBE_SECRET=your-random-secret
# Base of links in confirmation/announcement mails and feeds (default https://sbozh.me);
# set it to your dev server so mailed links come back here
SITE_URL=http://localhost:3000
# Directus announcement flows send it in X-Announce-Secret (local compose default)
ANNOUNCE_SECRET=local-announce-secret

# Production values (set in docker-compose):
# DIRECTUS_URL=https://directus.sbozh.me
# UMAMI_SCRIPT_URL=https://analytics.sbozh.me/script.js
# SENTRY_DSN=https://your-key@monitoring.sbozh.me/1
